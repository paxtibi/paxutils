<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="paxutils_package"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\src;..\src\$(TargetOS)"/>
        <UnitOutputDirectory Value="..\lib\$(TargetCPU)-$(TargetOS)\fpc-$(FPC_FULLVERSION)"/>
      </SearchPaths>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="0"/>
        </Optimizations>
      </CodeGeneration>
    </CompilerOptions>
    <Files Count="5">
      <Item1>
        <Filename Value="..\src\windows\pax.utils.pas"/>
        <UnitName Value="pax.utils"/>
      </Item1>
      <Item2>
        <Filename Value="..\src\windows\pax.utils.colors.pas"/>
        <UnitName Value="pax.utils.colors"/>
      </Item2>
      <Item3>
        <Filename Value="..\src\pax.utils.containers.pas"/>
        <UnitName Value="pax.utils.containers"/>
      </Item3>
      <Item4>
        <Filename Value="..\src\pax.utils.arraylist.pas"/>
        <AddToUsesPkgSection Value="False"/>
        <UnitName Value="pax.utils.arraylist"/>
      </Item4>
      <Item5>
        <Filename Value="..\src\pax.utils.linkedlist.pas"/>
        <AddToUsesPkgSection Value="False"/>
        <UnitName Value="pax.utils.linkedlist"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="paxtypes_package"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <CustomOptions Items="ExternHelp" Version="2">
      <_ExternHelp Items="Count"/>
    </CustomOptions>
  </Package>
</CONFIG>
